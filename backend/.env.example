# Required for the /admin page and admin WebSocket commands.
# Use a generated secret in real deployments.
ADMIN_PASSWORD=change-me

# Railway sets PORT automatically. For local development, uvicorn usually uses 8000.
# PORT=8000

# Comma-separated frontend origins allowed to connect to the backend.
# Use your Railway frontend URL in production.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
