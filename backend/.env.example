# Required for /globaladmin and server-wide emergency controls.
# Use a generated secret in real deployments.
GLOBAL_ADMIN_PASSWORD=change-me-global

# Optional fallback for GLOBAL_ADMIN_PASSWORD during local development.
ADMIN_PASSWORD=change-me

# Railway sets PORT automatically. For local development, uvicorn usually uses 8000.
# PORT=8000

# Multi-room capacity and cleanup limits.
MAX_TOTAL_PLAYERS=100
EMPTY_ROOM_TTL_SECONDS=300
FINAL_RESULTS_TTL_SECONDS=600

# Comma-separated frontend origins allowed to connect to the backend.
# Use your Railway frontend URL in production.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
